# Google Gemini API key. Required for the "Investigate with Agent" feature.
# Get one at https://aistudio.google.com/apikey
# Without this set, every other part of CrisisDesk still works (dashboard,
# incidents, services, WebMCP tools) — only the AI agent loop is disabled,
# and it fails with a clear, structured error rather than crashing.
GEMINI_API_KEY=

# Optional: override the default Gemini model (gemini-3.6-flash).
GEMINI_MODEL=

# Public base URL of the deployed app (used in generated links/metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
